APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_PLATFORM_PUBLIC_URL=${APP_URL}
FRONTEND_PLATFORM_AUTH_URL=${APP_URL}
FRONTEND_PLATFORM_ADMIN_URL=${APP_URL}/admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central

CENTRAL_DATABASE_URL=
CENTRAL_DB_HOST=mysql
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=webuildyouthrive_central
CENTRAL_DB_USERNAME=wbyt_central_app
CENTRAL_DB_PASSWORD=
CENTRAL_DB_SOCKET=
CENTRAL_DB_CHARSET=utf8mb4
CENTRAL_DB_COLLATION=utf8mb4_0900_ai_ci
CENTRAL_DB_CONNECT_TIMEOUT=5
CENTRAL_DB_SSL_MODE=preferred
CENTRAL_DB_SSL_CA=
CENTRAL_DB_TIMEZONE=+00:00

TENANT_DB_DRIVER=mysql
TENANT_DB_HOST=mysql
TENANT_DB_PORT=3306
TENANT_DB_CHARSET=utf8mb4
TENANT_DB_COLLATION=utf8mb4_0900_ai_ci
TENANT_DB_CONNECT_TIMEOUT=5
TENANT_DB_SSL_MODE=preferred
TENANT_DB_SSL_CA=
TENANT_DB_TIMEZONE=+00:00
TENANT_DB_SECRET_PROVIDER=config
TENANT_DB_FALLBACK_USERNAME=
TENANT_DB_FALLBACK_PASSWORD=
PLATFORM_DOMAINS=localhost,127.0.0.1
TENANCY_RESOLUTION_CACHE_STORE=redis
TENANCY_RESOLUTION_CACHE_PREFIX=tenant-domain-resolution:
TENANCY_RESOLUTION_CACHE_TTL=300
TENANCY_RESOLUTION_CACHE_TTL_SECONDS=300
TENANCY_NEGATIVE_CACHE_TTL=30
TENANCY_UNKNOWN_HOST_BEHAVIOR=reject
TENANCY_LOCAL_DOMAINS_ENABLED=true

DEMO_SEEDING_ENABLED=false
DEMO_AUTO_SEED_ON_DATABASE_SEEDER=true
DEMO_USER_PASSWORD=DemoPassword!2026
DEMO_DATA_PROFILE=standard
DEMO_DATA_REFERENCE_DATE=

TEST_CENTRAL_DB_DATABASE=wbyt_test_central
TEST_TENANT_DB_PREFIX=wbyt_test_tenant_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=session
SESSION_COOKIE=wbyt-platform-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

CACHE_STORE=redis
CACHE_PREFIX=wbyt-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=wbyt-redis-
REDIS_CACHE_CONNECTION=cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
