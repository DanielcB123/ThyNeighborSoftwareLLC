<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="central"/>
        <env name="CENTRAL_DB_HOST" value="mysql"/>
        <env name="CENTRAL_DB_PORT" value="3306"/>
        <env name="CENTRAL_DB_DATABASE" value="wbyt_test_central"/>
        <env name="CENTRAL_DB_USERNAME" value="root"/>
        <env name="CENTRAL_DB_PASSWORD" value=""/>
        <env name="CENTRAL_DB_CHARSET" value="utf8mb4"/>
        <env name="CENTRAL_DB_COLLATION" value="utf8mb4_0900_ai_ci"/>
        <env name="CENTRAL_DB_SSL_MODE" value="preferred"/>
        <env name="TENANT_DB_DRIVER" value="mysql"/>
        <env name="TENANT_DB_PORT" value="3306"/>
        <env name="TENANT_DB_CHARSET" value="utf8mb4"/>
        <env name="TENANT_DB_COLLATION" value="utf8mb4_0900_ai_ci"/>
        <env name="TENANT_DB_SSL_MODE" value="preferred"/>
        <env name="TEST_CENTRAL_DB_DATABASE" value="wbyt_test_central"/>
        <env name="TEST_TENANT_DB_PREFIX" value="wbyt_test_tenant_"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="DEMO_AUTO_SEED_ON_DATABASE_SEEDER" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
