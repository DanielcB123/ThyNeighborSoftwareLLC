{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint \"resources/js/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx,d.ts}\" \"docs/**/*.md\"",
        "test:unit": "vitest run unit.test.ts",
        "test:component": "vitest run --environment jsdom component.test.ts",
        "test:browser": "vitest run --environment jsdom browser.test.ts",
        "test:accessibility": "vitest run --environment jsdom a11y.test.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.1.2",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "autoprefixer": "^10.4.12",
        "axe-core": "^4.12.1",
        "axios": "^1.18.1",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "prettier": "^3.9.6",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "vitest-axe": "^0.1.0",
        "vue": "^3.4.0",
        "vue-tsc": "^3.3.8"
    },
    "dependencies": {
        "three": "^0.185.1",
        "ziggy-js": "^2.6.3"
    }
}
